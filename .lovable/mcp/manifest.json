      {
        "name": "create_cycle",
        "title": "Create test cycle with groups and scenarios",
        "description": "Create a complete cycle in one call: cycle row + groups + scenarios. Use this after parsing a QA checklist. Scenario descriptions should follow the platform's standard format (What this is / What to try / Expected).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ],
              "default": "medium"
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "active",
                "archived"
              ],
              "default": "draft"
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "scenarios": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "scenario_code": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "scenario_code",
                        "title"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "name",
                  "scenarios"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "project_id",
            "name",
            "groups"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
